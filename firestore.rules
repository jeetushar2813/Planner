rules_version = '2';

// Team Planner security rules.
//
// These rules are the real protection for your data. The buttons hidden in the
// web page are only a convenience, because anyone can open the browser tools and
// try to bypass them. Every permission in the table in the planning document is
// enforced here.
//
// Roles (stored in users/{uid}.role): director, manager, leader, asst_leader, member
// HR (users/{uid}.hr == true): sets the yearly leave entitlements, acknowledges approved leave and
// reads every leave record. It is a switch on the account, so an HR person keeps their own role and
// team. Only a Director or Superuser can switch it on; being a Director gives none of these HR powers.
// Superuser (users/{uid}.superuser == true): every power of the Director, whatever the role.
// Only a Director or another Superuser can switch it on or off.
// Scope: a person's teams are stored in users/{uid}.teamIds. Everyone except the
// Director only sees and changes work for teams listed there.
//
// Accountability: every write to a task, comment, user, team, project or status
// must come in the SAME batch as a matching entry in activityLog, and log entries
// can never be edited or deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function meDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return meDoc().data; }

    // Signed in, has a user record, and that record is active. A person whose
    // account was deactivated is locked out of everything.
    function active() {
      return request.auth != null && meDoc().data.active == true;
    }
    function role() { return me().role; }

    // A Superuser keeps their own role (for example Team Leader) but has Director powers.
    // The field is optional, so older accounts without it are read with a default.
    function isSuperuser()  { return active() && me().get('superuser', false) == true; }
    function isHr()         { return active() && me().get('hr', false) == true; }
    function isDirector()   { return active() && (role() == 'director' || me().get('superuser', false) == true); }
    function isLeaderUp()   { return active() && (role() in ['director', 'manager', 'leader'] || me().get('superuser', false) == true); }
    function inTeam(teamId) { return active() && teamId in me().teamIds; }
    function inScope(teamId) { return isDirector() || inTeam(teamId); }

    function logPath(logId) {
      return /databases/$(database)/documents/activityLog/$(logId);
    }

    // True only if a log entry written in this same batch names this person,
    // this kind of item, this item, and carries this request's server time.
    function logged(type, entityId, logId) {
      return logId is string
        && getAfter(logPath(logId)).data.actorId == request.auth.uid
        && getAfter(logPath(logId)).data.entityType == type
        && getAfter(logPath(logId)).data.entityId == entityId
        && getAfter(logPath(logId)).data.ts == request.time;
    }

    // The person named as owner of a project. Projects made before owners existed have
    // no ownerId, so the field is read with a default. New branches that use this are
    // always placed last in an OR chain, so everyday checks never pay for the extra read.
    function ownsProject(projectId) {
      return projectId is string
        && active()
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('ownerId', null)
             == request.auth.uid;
    }

    function categoryOf(statusId) {
      return get(/databases/$(database)/documents/statuses/$(statusId)).data.category;
    }

    // ------------------------------------------------------------------ tasks

    match /tasks/{taskId} {

      function validShape(d) {
        return d.keys().hasAll([
            'title', 'description', 'teamId', 'projectId', 'ownerId', 'createdBy',
            'status', 'statusCategory', 'statusNote', 'priority', 'startDate',
            'dueDate', 'estimateHours', 'checklist', 'archived', 'completedAt',
            'completedDate', 'submits', 'reworks', 'createdAt', 'updatedAt', 'lastLogId'
          ])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.description is string && d.description.size() <= 5000
          && d.teamId is string
          && (d.projectId == null || d.projectId is string)
          && d.ownerId is string
          && d.status is string
          && d.statusCategory in ['todo', 'active', 'review', 'paused', 'done', 'closed']
          && d.statusCategory == categoryOf(d.status)
          && (d.statusNote == null || (d.statusNote is string && d.statusNote.size() <= 500))
          && d.priority in ['low', 'medium', 'high', 'urgent']
          && (d.startDate == null || (d.startDate is string && d.startDate.size() == 10))
          && (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10))
          && (d.estimateHours == null || (d.estimateHours is number && d.estimateHours >= 0))
          && d.checklist is list && d.checklist.size() <= 60
          // Who may tick the steps. Kept by the web page from the steps themselves.
          && (!('checklistAssignees' in d) || (d.checklistAssignees is list && d.checklistAssignees.size() <= 60))
          && (!('checklistForTeam' in d) || d.checklistForTeam is bool)
          // Optional extras (older tasks do not have them): tags, "blocked by" tasks, who gave the
          // task to its owner and when (used for the "new for you" alert), and the template a
          // recurring task came from.
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 8))
          && (!('blockedBy' in d) || (d.blockedBy is list && d.blockedBy.size() <= 5))
          && (!('assignedBy' in d) || d.assignedBy is string)
          && (!('assignedAt' in d) || d.assignedAt is timestamp)
          && (!('recurringId' in d) || d.recurringId is string)
          && d.archived is bool
          && d.submits is number && d.reworks is number;
      }

      // The owner must belong to the task's team.
      function ownerInTeam(d) {
        return d.teamId in get(/databases/$(database)/documents/users/$(d.ownerId)).data.teamIds;
      }

      // Completed date is stamped by the server when a task reaches a Done status,
      // and cleared again if the task is reopened.
      function completionOk(b, a) {
        return a.statusCategory == 'done'
          ? (b.statusCategory == 'done'
              ? a.completedAt == b.completedAt
              : a.completedAt == request.time)
          : a.completedAt == null;
      }

      // A team can switch the approval gate off, so members may mark their own
      // tasks Completed. By default (gate on) only leaders can approve.
      function gateOff(teamId) {
        return get(/databases/$(database)/documents/teams/$(teamId)).data.approvalGate == false;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function memberMayUpdate(b, a) {
        return b.ownerId == request.auth.uid
          && inTeam(b.teamId)
          && !(b.statusCategory in ['done', 'closed'])
          && changedKeys().hasOnly([
              'status', 'statusCategory', 'statusNote', 'checklist', 'completedAt',
              'completedDate', 'submits', 'reworks', 'updatedAt', 'lastLogId'
            ])
          && (a.statusCategory in ['todo', 'active', 'review', 'paused']
              || (a.statusCategory == 'done' && gateOff(b.teamId)));
      }

      // A person a checklist step was given to (or, for a step given to the whole team, anyone
      // in the task's team) may tick steps on that task and nothing else. The rules cannot read
      // inside the list, so the page keeps two summary fields up to date: checklistAssignees
      // (people) and checklistForTeam (true when any step belongs to the whole team). A helper
      // cannot change those two fields, only the steps themselves.
      function checklistHelperMayUpdate(b, a) {
        return inTeam(b.teamId)
          && a.teamId == b.teamId
          && !(b.statusCategory in ['done', 'closed'])
          && changedKeys().hasOnly(['checklist', 'updatedAt', 'lastLogId'])
          && (b.get('checklistForTeam', false) == true
              || request.auth.uid in b.get('checklistAssignees', []));
      }

      function canUpdate(b, a) {
        return isDirector()
          // Manager and Team Leader: everything inside their own team(s).
          || (role() in ['manager', 'leader']
              && inTeam(b.teamId) && inTeam(a.teamId)
              && (a.ownerId == b.ownerId || ownerInTeam(a)))
          // Assistant Team Leader: same, except deadlines and archiving.
          || (role() == 'asst_leader'
              && inTeam(b.teamId) && a.teamId == b.teamId
              && a.dueDate == b.dueDate && a.archived == b.archived
              && (a.ownerId == b.ownerId || ownerInTeam(a)))
          // Team Member: only status, checklist and progress on their own task.
          || (role() == 'member' && memberMayUpdate(b, a))
          // Project owner (any role): may hand a task of their project to someone else,
          // and may approve or send back work that is waiting in Review. Nothing else:
          // titles, dates, priority, checklist, archiving and the project itself stay as they are.
          || projectOwnerMayUpdate(b, a)
          // Someone a checklist step was given to: only the steps.
          || checklistHelperMayUpdate(b, a);
      }

      function projectOwnerMayUpdate(b, a) {
        return ownsProject(b.projectId)
          && a.projectId == b.projectId
          && b.ownerId != request.auth.uid
          && changedKeys().hasOnly([
              'ownerId', 'teamId', 'status', 'statusCategory', 'statusNote', 'completedAt',
              'completedDate', 'submits', 'reworks', 'assignedAt', 'assignedBy', 'updatedAt', 'lastLogId'
            ])
          && ((a.ownerId == b.ownerId && a.teamId == b.teamId) || ownerInTeam(a))
          && (a.statusCategory == b.statusCategory || b.statusCategory == 'review');
      }

      function canCreate(d) {
        return isDirector()
          || (role() in ['manager', 'leader', 'asst_leader']
              && inTeam(d.teamId) && ownerInTeam(d))
          || (role() == 'member'
              && d.ownerId == request.auth.uid && inTeam(d.teamId)
              && d.statusCategory in ['todo', 'active'])
          // Project owner: may give work in their project to anyone, in that person's team.
          || (d.projectId is string && ownsProject(d.projectId) && ownerInTeam(d));
      }

      // Read: your own tasks, and tasks of your own team(s). Directors read all.
      // Also tasks in a project you own, and tasks you handed to someone else.
      allow get, list: if active()
        && (isDirector()
            || resource.data.ownerId == request.auth.uid
            || inTeam(resource.data.teamId)
            || resource.data.createdBy == request.auth.uid
            || ownsProject(resource.data.projectId));

      allow create: if active()
        && validShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.archived == false
        && request.resource.data.completedAt == null
        && request.resource.data.statusCategory in ['todo', 'active', 'review', 'paused']
        && canCreate(request.resource.data)
        && logged('task', taskId, request.resource.data.lastLogId);

      allow update: if active()
        && validShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLogId != resource.data.lastLogId
        && completionOk(resource.data, request.resource.data)
        && canUpdate(resource.data, request.resource.data)
        && logged('task', taskId, request.resource.data.lastLogId);

      // Tasks are never deleted. Leaders archive them instead, and that is logged.
      allow delete: if false;

      // --------------------------------------------------------- comments

      match /comments/{commentId} {
        function parentTask() {
          return get(/databases/$(database)/documents/tasks/$(taskId)).data;
        }
        function canSeeParent() {
          return isDirector()
            || parentTask().ownerId == request.auth.uid
            || inTeam(parentTask().teamId)
            || parentTask().createdBy == request.auth.uid
            || ownsProject(parentTask().projectId);
        }

        allow get, list: if active() && canSeeParent();

        allow create: if active() && canSeeParent()
          && request.resource.data.keys().hasOnly(
               ['authorId', 'authorName', 'text', 'createdAt', 'logId', 'mentions'])
          && (!('mentions' in request.resource.data)
              || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 5))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && logged('comment', commentId, request.resource.data.logId);

        // Comments are permanent so the discussion stays trustworthy.
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- mentions
    // "@Name" in a comment. The comment lists the people it mentions (at most 5) and, in the SAME
    // batch, one small note is written for each of them. The note can only be made by the author
    // of that comment and only for someone the comment names, so nobody can send alerts out of the
    // blue. The person it is for reads it and can mark it read; nothing else can change and
    // nothing is deleted.

    match /mentions/{mentionId} {
      function commentOf(d) {
        return getAfter(/databases/$(database)/documents/tasks/$(d.taskId)/comments/$(d.commentId)).data;
      }

      allow get, list: if active() && resource.data.toId == request.auth.uid;

      allow create: if active()
        && request.resource.data.keys().hasOnly(
             ['toId', 'fromId', 'fromName', 'taskId', 'taskTitle', 'commentId', 'snippet', 'read', 'createdAt'])
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.taskId is string
        && request.resource.data.commentId is string
        && request.resource.data.taskTitle is string && request.resource.data.taskTitle.size() <= 200
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100
        && request.resource.data.snippet is string && request.resource.data.snippet.size() <= 160
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && commentOf(request.resource.data).authorId == request.auth.uid
        && request.resource.data.toId in commentOf(request.resource.data).get('mentions', [])
        && get(/databases/$(database)/documents/users/$(request.resource.data.toId)).data.active == true;

      // The person it is for marks it read. Nothing else may change.
      allow update: if active()
        && resource.data.toId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if false;
    }

    // -------------------------------------------------------- task templates
    // A template is a saved task. It can repeat (weekly, monthly ...). With no server, the web page
    // of a Team Leader, Manager or Director makes the task that is due when they open the app and
    // moves the next date on in the same write, so each occurrence is made once.

    match /taskTemplates/{templateId} {

      function validTemplate(d) {
        return d.keys().hasAll([
            'name', 'teamId', 'title', 'description', 'priority', 'ownerIds', 'repeat',
            'nextDate', 'active', 'createdBy', 'createdAt', 'updatedAt', 'lastLogId'
          ])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.teamId is string
          && d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && d.description is string && d.description.size() <= 5000
          && d.priority in ['low', 'medium', 'high', 'urgent']
          && d.ownerIds is list && d.ownerIds.size() >= 1 && d.ownerIds.size() <= 5
          && d.repeat in ['none', 'weekly', 'fortnightly', 'monthly', 'quarterly', 'yearly']
          && (d.nextDate == null || (d.nextDate is string && d.nextDate.size() == 10))
          && d.active is bool
          && (!('projectId' in d) || d.projectId == null || d.projectId is string)
          && (!('estimateHours' in d) || d.estimateHours == null || (d.estimateHours is number && d.estimateHours >= 0))
          && (!('dueInDays' in d) || d.dueInDays == null || (d.dueInDays is number && d.dueInDays >= 0 && d.dueInDays <= 365))
          && (!('tags' in d) || (d.tags is list && d.tags.size() <= 8))
          && (!('checklist' in d) || (d.checklist is list && d.checklist.size() <= 60))
          && (!('lastRunDate' in d) || d.lastRunDate == null || d.lastRunDate is string);
      }

      function manages(teamId) {
        return isDirector() || (role() in ['manager', 'leader'] && inTeam(teamId));
      }

      // Read: the Director, and Team Leaders, Managers and Assistants of the template's team.
      allow get, list: if active()
        && (isDirector()
            || (role() in ['manager', 'leader', 'asst_leader'] && inTeam(resource.data.teamId)));

      allow create: if active()
        && validTemplate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && manages(request.resource.data.teamId)
        && logged('template', templateId, request.resource.data.lastLogId);

      allow update: if active()
        && validTemplate(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLogId != resource.data.lastLogId
        && manages(resource.data.teamId)
        && manages(request.resource.data.teamId)
        && logged('template', templateId, request.resource.data.lastLogId);

      // Templates are switched off (active: false), never deleted.
      allow delete: if false;
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {

      function validUser(d) {
        return d.keys().hasAll([
            'name', 'email', 'role', 'teamIds', 'active',
            'createdAt', 'lastLoginAt', 'lastLogId'
          ])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() <= 200
          && d.role in ['director', 'manager', 'leader', 'asst_leader', 'member']
          && d.teamIds is list && d.teamIds.size() <= 20
          && (!('superuser' in d) || d.superuser is bool)
          && (!('hr' in d) || d.hr is bool)
          && d.active is bool;
      }

      function changedUserKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Everyone signed in can read the staff list, because names are needed
      // next to tasks. It holds no passwords.
      allow get, list: if active();

      // Only the Director creates accounts and sets roles.
      allow create: if isDirector()
        && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && logged('user', userId, request.resource.data.lastLogId);

      allow update: if
        (isDirector()
          && validUser(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.lastLogId != resource.data.lastLogId
          // Nobody can lock themselves out: on their own account they may not deactivate it, and
          // must still be a Director or a Superuser afterwards. (This is what lets a Director
          // make themselves a Superuser and then change their role to Team Leader, but stops
          // a Superuser from removing their own powers by mistake. Another Director can.)
          && (userId != request.auth.uid
              || (request.resource.data.active == resource.data.active
                  && (request.resource.data.role == 'director'
                      || request.resource.data.get('superuser', false) == true)))
          && logged('user', userId, request.resource.data.lastLogId))
        ||
        // Everyone else may only record their own sign-in.
        (active()
          && request.auth.uid == userId
          && changedUserKeys().hasOnly(['lastLoginAt', 'lastLogId'])
          && request.resource.data.lastLoginAt == request.time
          && request.resource.data.lastLogId != resource.data.lastLogId
          && logged('user', userId, request.resource.data.lastLogId))
        ||
        // Everyone may choose their own colour theme (a preference, so it needs no log entry).
        // Keep this list in step with js/core/theme.js and css/themes.css.
        (active()
          && request.auth.uid == userId
          && changedUserKeys().hasOnly(['theme'])
          && request.resource.data.theme in [
               'auto', 'light', 'dark', 'corporate', 'blue', 'slate',
               'colourful', 'purple', 'midnight', 'forest'
             ]);

      // Accounts are deactivated, never deleted, so history stays attached to a name.
      allow delete: if false;
    }

    // ------------------------------------------------------------------ teams

    match /teams/{teamId} {

      function validTeam(d) {
        return d.keys().hasAll(['name', 'approvalGate', 'active', 'createdAt', 'lastLogId'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.approvalGate is bool
          && d.active is bool;
      }

      allow get, list: if active();

      allow create: if isDirector()
        && validTeam(request.resource.data)
        && request.resource.data.createdAt == request.time
        && logged('team', teamId, request.resource.data.lastLogId);

      allow update: if active()
        && validTeam(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLogId != resource.data.lastLogId
        && (isDirector()
            || (role() == 'manager' && inTeam(teamId)
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['name', 'lastLogId'])))
        && logged('team', teamId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // --------------------------------------------------------------- projects

    match /projects/{projectId} {

      function validProject(d) {
        return d.keys().hasAll(
            ['name', 'teamId', 'description', 'active', 'createdAt', 'lastLogId'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.teamId is string
          && d.description is string && d.description.size() <= 1000
          && d.active is bool
          // One owner per project, any person. Optional, so older projects stay valid.
          && (d.get('ownerId', null) == null || d.ownerId is string);
      }

      allow get, list: if active();

      allow create: if isLeaderUp()
        && inScope(request.resource.data.teamId)
        && validProject(request.resource.data)
        && request.resource.data.createdAt == request.time
        && logged('project', projectId, request.resource.data.lastLogId);

      allow update: if isLeaderUp()
        && inScope(resource.data.teamId)
        && inScope(request.resource.data.teamId)
        && validProject(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLogId != resource.data.lastLogId
        && logged('project', projectId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // --------------------------------------------------------------- statuses

    match /statuses/{statusId} {

      function validStatus(d) {
        return d.keys().hasAll(
            ['name', 'category', 'color', 'order', 'active', 'needsReason', 'lastLogId'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.category in ['todo', 'active', 'review', 'paused', 'done', 'closed']
          && d.color is string && d.color.size() <= 9
          && d.order is number
          && d.active is bool
          && d.needsReason is bool;
      }

      allow get, list: if active();

      // Only the Director customises the list of statuses.
      allow create: if isDirector()
        && validStatus(request.resource.data)
        && logged('status', statusId, request.resource.data.lastLogId);

      allow update: if isDirector()
        && validStatus(request.resource.data)
        && request.resource.data.lastLogId != resource.data.lastLogId
        && logged('status', statusId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // ------------------------------------------------------------------ leave
    //
    // Members and everyone else ask for leave for themselves (it waits for approval).
    // Managers and Team Leaders approve or decline for their own team(s); the Director
    // for everyone. They can also record approved leave for someone in their team.
    // Only the person or an approver can cancel it. Nothing is ever deleted.
    // One request is stored for each team the person belongs to.

    match /leaves/{leaveId} {

      function validLeave(d) {
        return d.keys().hasAll([
            'userId', 'userName', 'teamId', 'type', 'startDate', 'endDate', 'half', 'reason',
            'status', 'requestedBy', 'decidedBy', 'decidedAt', 'decisionNote',
            'createdAt', 'updatedAt', 'lastLogId'
          ])
          && d.userId is string
          && d.userName is string && d.userName.size() <= 100
          && d.teamId is string
          && d.type in ['annual', 'sick', 'training', 'other', 'compassionate', 'marriage', 'hospitalization']
          && d.startDate is string && d.startDate.size() == 10
          && d.endDate is string && d.endDate.size() == 10 && d.endDate >= d.startDate
          && d.half in ['full', 'am', 'pm'] && (d.half == 'full' || d.startDate == d.endDate)
          && d.reason is string && d.reason.size() <= 300
          && d.status in ['pending', 'leader_ok', 'approved', 'declined', 'cancelled']
          && (!('leaderBy' in d) || d.leaderBy == null || d.leaderBy is string)
          && (!('hrAckBy' in d) || d.hrAckBy == null || d.hrAckBy is string)
          && (d.decisionNote == null || (d.decisionNote is string && d.decisionNote.size() <= 300));
      }

      function approver(teamId) {
        return isDirector() || (role() in ['manager', 'leader'] && inTeam(teamId));
      }

      function person(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Your own leave, your approvers and the Director. Deputies see their team's leave
      // so they can plan, but cannot decide on it. Other members see only their own.
      allow get, list: if active()
        && (isDirector()
            || resource.data.userId == request.auth.uid
            || (role() in ['manager', 'leader', 'asst_leader'] && inTeam(resource.data.teamId))
            // HR reads every leave record (read-only), to acknowledge it and to work out balances.
            || isHr());

      allow create: if active()
        && validLeave(request.resource.data)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && person(request.resource.data.userId).teamIds.hasAny([request.resource.data.teamId])
        && person(request.resource.data.userId).name == request.resource.data.userName
        && request.resource.data.get('hrAckBy', null) == null
        && (
          // Own request. It goes to the Team Leader first. A Manager or Team Leader has no one
          // above them in the team, so theirs goes straight to the Director. A Director or
          // Superuser may approve their own.
          (request.resource.data.userId == request.auth.uid
            && inTeam(request.resource.data.teamId)
            && request.resource.data.decisionNote == null
            && request.resource.data.get('leaderBy', null) == null
            && ((request.resource.data.status == 'pending'
                  && request.resource.data.decidedBy == null
                  && request.resource.data.decidedAt == null)
                || (request.resource.data.status == 'leader_ok'
                    && (role() in ['manager', 'leader'] || isDirector())
                    && request.resource.data.decidedBy == null
                    && request.resource.data.decidedAt == null)
                || (request.resource.data.status == 'approved'
                    && isDirector()
                    && request.resource.data.decidedBy == request.auth.uid
                    && request.resource.data.decidedAt == request.time)))
          ||
          // Recorded for someone else. A Team Leader or Manager's record counts as the Team
          // Leader's approval and waits for the Director; the Director's record is final.
          (request.resource.data.userId != request.auth.uid
            && approver(request.resource.data.teamId)
            && request.resource.data.decisionNote == null
            && ((request.resource.data.status == 'leader_ok'
                  && request.resource.data.get('leaderBy', null) == request.auth.uid
                  && request.resource.data.get('leaderAt', null) == request.time
                  && request.resource.data.decidedBy == null
                  && request.resource.data.decidedAt == null)
                || (request.resource.data.status == 'approved'
                    && isDirector()
                    && request.resource.data.decidedBy == request.auth.uid
                    && request.resource.data.decidedAt == request.time)))
        )
        && logged('leave', leaveId, request.resource.data.lastLogId);

      allow update: if active()
        && validLeave(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLogId != resource.data.lastLogId
        && (
          // Cancel: the person, or an approver for that team.
          (changed().hasOnly(['status', 'updatedAt', 'lastLogId'])
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'leader_ok', 'approved']
            && (resource.data.userId == request.auth.uid || approver(resource.data.teamId)))
          ||
          // Step 1, Team Leader (or Manager, or Director): pending -> waiting for the Director.
          // Never on their own request, except the Director.
          (changed().hasOnly(['status', 'leaderBy', 'leaderAt', 'updatedAt', 'lastLogId'])
            && resource.data.status == 'pending'
            && request.resource.data.status == 'leader_ok'
            && approver(resource.data.teamId)
            && (resource.data.userId != request.auth.uid || isDirector())
            && request.resource.data.leaderBy == request.auth.uid
            && request.resource.data.leaderAt == request.time)
          ||
          // Step 2, the Director (or a Superuser): waiting for the Director -> approved.
          (changed().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote', 'updatedAt', 'lastLogId'])
            && resource.data.status == 'leader_ok'
            && request.resource.data.status == 'approved'
            && isDirector()
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.decidedAt == request.time)
          ||
          // Decline, with a reason: the Team Leader at step 1, the Director at either step.
          (changed().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote', 'updatedAt', 'lastLogId'])
            && request.resource.data.status == 'declined'
            && request.resource.data.decisionNote is string
            && request.resource.data.decidedBy == request.auth.uid
            && request.resource.data.decidedAt == request.time
            && ((resource.data.status == 'pending' && approver(resource.data.teamId))
                || (resource.data.status == 'leader_ok' && isDirector()))
            && (resource.data.userId != request.auth.uid || isDirector()))
          ||
          // HR acknowledges approved leave. This is a record only; it changes nothing about
          // the approval, and leave is already approved without it.
          (changed().hasOnly(['hrAckBy', 'hrAckAt', 'updatedAt', 'lastLogId'])
            && resource.data.status == 'approved'
            && resource.data.get('hrAckBy', null) == null
            && isHr()
            && request.resource.data.hrAckBy == request.auth.uid
            && request.resource.data.hrAckAt == request.time)
        )
        && logged('leave', leaveId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // --------------------------------------------------------------- holidays
    //
    // Public holidays and team closures. Everyone can read them. The Director sets
    // holidays for everyone; Managers and Team Leaders set them for their own team.

    match /holidays/{holidayId} {

      function validHoliday(d) {
        return d.keys().hasAll(['name', 'date', 'teamId', 'active', 'createdAt', 'lastLogId'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.date is string && d.date.size() == 10
          && (d.teamId == null || d.teamId is string)
          && d.active is bool;
      }

      function mayManage(teamId) {
        return isDirector()
          || (role() in ['manager', 'leader'] && teamId != null && inTeam(teamId));
      }

      allow get, list: if active();

      allow create: if active()
        && validHoliday(request.resource.data)
        && mayManage(request.resource.data.teamId)
        && request.resource.data.createdAt == request.time
        && logged('holiday', holidayId, request.resource.data.lastLogId);

      allow update: if active()
        && validHoliday(request.resource.data)
        && mayManage(resource.data.teamId)
        && mayManage(request.resource.data.teamId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLogId != resource.data.lastLogId
        && logged('holiday', holidayId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // ------------------------------------------------------------------ key dates
    // Dates worth marking on the calendar that are not tasks and not days off: "Semester 1 starts",
    // "Exam week", "Open day". A key date has a first day and a last day (the same day for a
    // one-day date), a team (or null for everyone), and may come back every year. Everyone signed in
    // can read them; the Director and Superuser write dates for everyone, Team Leaders and Managers
    // write dates for their own team. They are switched off (active: false), never deleted.

    match /keyDates/{keyDateId} {

      function validKeyDate(d) {
        return d.keys().hasAll([
            'title', 'startDate', 'endDate', 'teamId', 'category', 'yearly', 'active',
            'createdBy', 'createdAt', 'updatedAt', 'lastLogId'
          ])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && d.startDate is string && d.startDate.size() == 10
          && d.endDate is string && d.endDate.size() == 10
          && d.endDate >= d.startDate
          && (d.teamId == null || d.teamId is string)
          && d.category in ['term', 'exam', 'event', 'deadline', 'other']
          && d.yearly is bool
          && d.active is bool
          && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 500));
      }

      function mayManageKeyDate(teamId) {
        return isDirector()
          || (role() in ['manager', 'leader'] && teamId != null && inTeam(teamId));
      }

      allow get, list: if active();

      allow create: if active()
        && validKeyDate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && mayManageKeyDate(request.resource.data.teamId)
        && logged('keydate', keyDateId, request.resource.data.lastLogId);

      allow update: if active()
        && validKeyDate(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastLogId != resource.data.lastLogId
        && mayManageKeyDate(resource.data.teamId)
        && mayManageKeyDate(request.resource.data.teamId)
        && logged('keydate', keyDateId, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // ------------------------------------------------------------ leave entitlements
    //
    // One document per year (id = "2026"): the days everyone gets for each kind of leave, plus
    // exceptions for named people. Everyone can read it (people need to see their own balance);
    // only HR can write it.

    match /leavePolicy/{year} {

      function validDays(m) {
        return m.keys().hasOnly(['annual', 'sick', 'compassionate', 'marriage', 'hospitalization'])
          && (!('annual' in m) || (m.annual is number && m.annual >= 0 && m.annual <= 366))
          && (!('sick' in m) || (m.sick is number && m.sick >= 0 && m.sick <= 366))
          && (!('compassionate' in m) || (m.compassionate is number && m.compassionate >= 0 && m.compassionate <= 366))
          && (!('marriage' in m) || (m.marriage is number && m.marriage >= 0 && m.marriage <= 366))
          && (!('hospitalization' in m) || (m.hospitalization is number && m.hospitalization >= 0 && m.hospitalization <= 366));
      }

      function validPolicy(d) {
        return d.keys().hasAll(['year', 'days', 'overrides', 'updatedAt', 'lastLogId'])
          && d.year == year
          && year.matches('^20[0-9][0-9]$')
          && d.days is map && validDays(d.days)
          && d.overrides is map && d.overrides.size() <= 300
          && d.updatedAt == request.time;
      }

      allow get, list: if active();

      allow create: if isHr()
        && validPolicy(request.resource.data)
        && logged('policy', year, request.resource.data.lastLogId);

      allow update: if isHr()
        && validPolicy(request.resource.data)
        && request.resource.data.lastLogId != resource.data.lastLogId
        && logged('policy', year, request.resource.data.lastLogId);

      allow delete: if false;
    }

    // ------------------------------------------------------------ activity log

    match /activityLog/{logId} {

      function validLog(d) {
        return d.keys().hasAll([
            'ts', 'actorId', 'actorName', 'actorRole', 'action', 'entityType',
            'entityId', 'entityTitle', 'teamId', 'changes', 'summary'
          ])
          && d.ts == request.time
          && d.actorId == request.auth.uid
          && d.actorRole == role()
          && d.action is string && d.action.size() <= 40
          && d.entityType in ['task', 'comment', 'user', 'team', 'project', 'status', 'leave', 'holiday', 'policy', 'template', 'keydate']
          && d.entityId is string
          && d.entityTitle is string && d.entityTitle.size() <= 300
          && (d.teamId == null || d.teamId is string)
          && d.changes is list && d.changes.size() <= 40
          && d.summary is string && d.summary.size() <= 600;
      }

      // The Director reads everything. Managers and Team Leaders read their own
      // team(s). Everyone else reads only their own activity.
      allow get, list: if active()
        && (isDirector()
            || resource.data.actorId == request.auth.uid
            || (role() in ['manager', 'leader'] && inTeam(resource.data.teamId)));

      allow create: if active() && validLog(request.resource.data);

      // Nobody, including the Director, can edit or delete a log entry.
      allow update, delete: if false;
    }
  }
}
